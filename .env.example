# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- App ---
APP_NAME=messaging-gateway
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s

# --- PostgreSQL (pgvector) ---
# Used both by the app (asyncpg) and by the `postgres` service in docker-compose.
POSTGRES_DIALECT=postgresql
POSTGRES_DRIVER=asyncpg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=messaging_gateway
SQL_ECHO=false
# Host path for the postgres volume (docker-compose only)
POSTGRES_DATA=./.docker/postgres

# --- Redis (event bus stream + auth throttling) ---
REDIS_HOST=localhost
REDIS_PORT=6379
MESSAGE_QUEUE_NAME=events
MESSAGE_GROUP_NAME=messaging-gateway-workers
# Host path for the redis volume (docker-compose only)
REDIS_DATA=./.docker/redis
# Host path for the redisinsight volume (docker-compose-dev only)
REDISINSIGHT_DATA=./.docker/redisinsight

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-long-random-string
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_SECONDS=300
AUTH_BLOCK_TIME_SECONDS=900
PASSWORD_RECOVERY_TIME_SECONDS=300

# --- Password recovery email ---
FRONTEND_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=

# --- Meta / WhatsApp Cloud API ---
WA_VERIFY_TOKEN=change-me
WA_API_URL=https://graph.facebook.com
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=

# --- OpenAI (agent LLM + FAQ embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Caddy (production only, docker-compose.yml) ---
CADDY_DATA=./.docker/caddy/data
CADDY_CONFIG=./.docker/caddy/config
